<Window x:Class="Mister.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mister.App.Views"
        Style="{StaticResource WorkbenchWindow}"
        Title="Technika Tools — Pack Workbench"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop"
        Closing="OnClosing"
        Closed="OnClosed">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                PanningMode="VerticalOnly"
                CanContentScroll="False">
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource Eyebrow}"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="Technika Tools" />
          <TextBlock Style="{StaticResource DisplayTitle}"
                     Margin="0,4,0,0"
                     Text="Pack Workbench" />
          <TextBlock Margin="1,7,0,0"
                     FontSize="15"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Browse one logical pack at a time, then inspect its assets at a comfortable size." />
        </StackPanel>
        <Border Grid.Column="1"
                VerticalAlignment="Top"
                Background="{StaticResource SuccessSubtleBrush}"
                BorderBrush="#9CCBB7"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,6">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource SuccessBrush}"
                     Text="{Binding SafetyStatus, Mode=OneWay}" />
        </Border>
      </Grid>

      <Expander Grid.Row="2"
                IsExpanded="False"
                Header="Setup &amp; evidence">
        <Border Margin="0,12,0,0"
                Style="{StaticResource SurfaceBorder}"
                Padding="22"
                IsEnabled="{Binding CanChangePrerequisites}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Open assets" />
              <TextBlock Margin="0,5,0,14"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextMutedBrush}"
                         Text="Choose the game client and its PAK files." />
              <WrapPanel>
                <Button Margin="0,0,8,8" Click="OnBrowseClient" Content="Open client" />
                <Button Margin="0,0,8,8" Click="OnBrowsePaks" Content="Add PAKs" />
                <Button Margin="0,0,0,8" Click="OnBrowsePakFolder" Content="Add folder" />
              </WrapPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BorderBrush}" />

            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Unlock previews" />
              <TextBlock Margin="0,5,0,14"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextMutedBrush}"
                         Text="Use Client_D for T3, existing pakkeys, or a saved T2 capture." />
              <WrapPanel>
                <Button Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnRecoverAllT3PakKeys"
                        IsEnabled="{Binding CanPrepareT3Recovery}"
                        Content="Recover from Client_D" />
                <Button Margin="0,0,8,8"
                        Click="OnBrowsePakKeys"
                        Content="Existing pakkeys" />
                <Button Margin="0,0,8,8"
                        Click="OnUseCaptureBundle"
                        IsEnabled="{Binding CanUseCaptureBundle}"
                        Content="T2 saved capture" />
                <Button Margin="0,0,0,8"
                        Command="{Binding RefreshEvidenceCommand}"
                        Content="Verify again" />
              </WrapPanel>
            </StackPanel>

            <Border Grid.Column="3"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BorderBrush}" />

            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Capture T2 once" />
              <TextBlock Margin="0,5,0,14"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextMutedBrush}"
                         Text="Create a reusable offline bundle from a running T2 client." />
              <WrapPanel>
                <Button Margin="0,0,8,8" Click="OnBrowseOutput" Content="Work folder" />
                <Button Margin="0,0,0,8"
                        Command="{Binding CaptureT2Command}"
                        Content="Capture running T2" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Expander>

      <Border Grid.Row="4"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="13,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="7"
                   Height="7"
                   VerticalAlignment="Center"
                   Fill="{StaticResource SuccessBrush}" />
          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="{Binding EvidenceStatus, Mode=OneWay}" />
          <TextBlock Grid.Column="3"
                     Margin="18,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="{Binding FamilyStatus, Mode=OneWay}" />
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="WorkspaceGrid"
          Grid.Row="2"
          MinHeight="500">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LibraryColumn" Width="350" MinWidth="0" />
        <ColumnDefinition x:Name="LibraryGapColumn" Width="18" />
        <ColumnDefinition Width="*" MinWidth="560" />
      </Grid.ColumnDefinitions>

      <Border x:Name="LibraryPanel"
              Grid.Column="0"
              MaxHeight="620"
              VerticalAlignment="Top"
              Style="{StaticResource SurfaceBorder}"
              Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="Library" />
                <TextBlock Style="{StaticResource SectionTitle}"
                           Margin="0,4,0,0"
                           Text="Packs &amp; files" />
              </StackPanel>
              <Border Grid.Column="1"
                      VerticalAlignment="Center"
                      Background="{StaticResource SurfaceHoverBrush}"
                      CornerRadius="12"
                      Padding="9,4">
                <TextBlock FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding PackGroups.Count, Mode=OneWay}" />
              </Border>
            </Grid>

            <TextBlock Margin="0,16,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Logical pack" />
            <ComboBox ItemsSource="{Binding PackGroups}"
                      SelectedItem="{Binding SelectedPack}"
                      AutomationProperties.Name="Logical pack collection">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name, Mode=OneWay}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Margin="1,7,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedPack}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding SelectedPack.LayerSummary, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding SelectedPack.FileCount, Mode=OneWay}" />
              <Run Text=" files" />
            </TextBlock>
          </StackPanel>

          <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="260"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Open a client or add a PAK folder to begin. Numbered update archives are grouped automatically.">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PackGroups.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <views:ArchiveInspectorView x:Name="ArchiveInspector">
              <views:ArchiveInspectorView.Style>
                <Style TargetType="{x:Type views:ArchiveInspectorView}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.PackGroups.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </views:ArchiveInspectorView.Style>
            </views:ArchiveInspectorView>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource SurfaceBorder}"
              Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Padding="24,20"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="Preview" />
                <TextBlock Style="{StaticResource SectionTitle}"
                           Margin="0,4,0,0"
                           FontSize="22"
                           Text="{Binding SelectedFileName, Mode=OneWay}" />
                <TextBlock Margin="0,6,0,0"
                           MaxWidth="760"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding SelectedFilePath, Mode=OneWay}"
                           ToolTip="{Binding SelectedFilePath, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Margin="20,0,0,0"
                          HorizontalAlignment="Right">
                <WrapPanel HorizontalAlignment="Right">
                  <Button x:Name="ExtractButton"
                          Margin="0,0,8,0"
                          Style="{StaticResource PrimaryButton}"
                          Click="OnExtract"
                          IsEnabled="{Binding CanExtract}"
                          Content="Extract &amp; verify" />
                  <ToggleButton x:Name="FitLargeImagesToggle"
                                Margin="0,0,8,0"
                                Style="{StaticResource PillToggleButton}"
                                IsChecked="True"
                                Content="Fit large images"
                                ToolTip="Large images shrink to fit. Small images never scale up." />
                  <ToggleButton x:Name="FocusPreviewToggle"
                                Style="{StaticResource PillToggleButton}"
                                Checked="OnPreviewFocusChanged"
                                Unchecked="OnPreviewFocusChanged"
                                Content="Focus preview" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}">
                  <Run Text="{Binding PreviewKindLabel, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding SelectedFileSummary, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="20">
            <Border x:Name="PreviewStageBorder"
                    MinHeight="480"
                    HorizontalAlignment="Stretch"
                    Background="#FAFAFA"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
              <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360">
                  <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPreviewEmpty}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Width="52"
                          Height="52"
                          HorizontalAlignment="Center"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="26">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Georgia"
                               FontSize="23"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="+" />
                  </Border>
                  <TextBlock Margin="0,16,0,0"
                             HorizontalAlignment="Center"
                             FontFamily="Georgia"
                             FontSize="19"
                             Text="Choose a file to preview" />
                  <TextBlock Margin="0,7,0,0"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource TextMutedBrush}"
                             Text="Preview images, text, audio, video, VCE animation, and unknown binaries safely here." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ProgressBar Width="200"
                               Height="4"
                               IsIndeterminate="True"
                               Foreground="{StaticResource PrimaryBrush}" />
                  <TextBlock Margin="0,13,0,0"
                             HorizontalAlignment="Center"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="Preparing preview…" />
                </StackPanel>

                <Viewbox Margin="24"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stretch="Uniform"
                         StretchDirection="DownOnly">
                  <Viewbox.Style>
                    <Style TargetType="{x:Type Viewbox}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasPreviewImage}" Value="True" />
                            <Condition Binding="{Binding IsChecked, ElementName=FitLargeImagesToggle}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Viewbox.Style>
                  <Image Stretch="Fill"
                         SnapsToDevicePixels="True"
                         Loaded="OnPixelPerfectImageLoaded"
                         TargetUpdated="OnPixelPerfectImageTargetUpdated"
                         Source="{Binding PreviewImage, NotifyOnTargetUpdated=True}" />
                </Viewbox>

                <ScrollViewer Margin="20"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                  <ScrollViewer.Style>
                    <Style TargetType="{x:Type ScrollViewer}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasPreviewImage}" Value="True" />
                            <Condition Binding="{Binding IsChecked, ElementName=FitLargeImagesToggle}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ScrollViewer.Style>
                  <Image HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stretch="Fill"
                         SnapsToDevicePixels="True"
                         Loaded="OnPixelPerfectImageLoaded"
                         TargetUpdated="OnPixelPerfectImageTargetUpdated"
                         Source="{Binding PreviewImage, NotifyOnTargetUpdated=True}" />
                </ScrollViewer>

                <views:MediaPlaybackView x:Name="MediaPlayerPreview"
                                         SourcePath="{Binding MediaPlaybackPath, Mode=OneWay}">
                  <views:MediaPlaybackView.Style>
                    <Style TargetType="{x:Type views:MediaPlaybackView}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMediaPlayback}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </views:MediaPlaybackView.Style>
                </views:MediaPlaybackView>

                <views:VcePlaybackView x:Name="VcePlayerPreview"
                                       Playback="{Binding VcePlayback, Mode=OneWay}">
                  <views:VcePlaybackView.Style>
                    <Style TargetType="{x:Type views:VcePlaybackView}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVcePlayback}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </views:VcePlaybackView.Style>
                </views:VcePlaybackView>

                <TextBox Margin="20"
                         Padding="18"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         Text="{Binding Preview.Text, Mode=OneWay}">
                  <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}"
                           BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreviewText}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <TextBox Margin="20"
                         Padding="18"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         Text="{Binding PreviewMetadataSummary, Mode=OneWay}">
                  <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}"
                           BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreviewMetadata}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <Border Margin="24"
                        Padding="18"
                        VerticalAlignment="Top"
                        Background="{StaticResource DangerSubtleBrush}"
                        BorderBrush="#E8B3B0"
                        BorderThickness="1"
                        CornerRadius="10">
                  <Border.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreviewError}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               Text="Preview could not be decoded" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding LastDiagnostic.Message, Mode=OneWay}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="2"
                  Padding="24,16"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                             Text="{Binding PreviewStatus, Mode=OneWay}" />
                  <TextBlock Margin="0,4,0,0"
                             FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Source: " />
                    <Run Text="{Binding SelectedFileSourceArchive, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" Margin="20,0,0,0">
                  <Button Margin="0,0,8,0"
                          Style="{StaticResource QuietButton}"
                          Command="{Binding PreviewCommand}"
                          Content="Refresh" />
                  <Button Margin="8,0,0,0"
                          Click="OnRecoverPakKey"
                          IsEnabled="{Binding CanRecoverPakKey}"
                          Content="Recover pakkey">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}"
                             BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ShowRecoverPakKey}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </WrapPanel>
              </Grid>

              <Expander Grid.Row="1"
                        Margin="0,12,0,0"
                        Header="Technical details">
                <Grid Margin="0,12,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource Eyebrow}" Text="Source layer" />
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource DataText}"
                             Text="{Binding Inspector.Details.SourceArchive, Mode=OneWay}" />
                  <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="File type" />
                  <TextBlock Grid.Column="6"
                             Style="{StaticResource DataText}"
                             Text="{Binding Inspector.Details.FileType, Mode=OneWay}" />

                  <TextBlock Grid.Row="2" Style="{StaticResource Eyebrow}" Text="Ordinal" />
                  <TextBlock Grid.Row="2" Grid.Column="2"
                             Style="{StaticResource DataText}"
                             Text="{Binding Inspector.Details.Ordinal, Mode=OneWay}" />
                  <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Eyebrow}" Text="Signature" />
                  <TextBlock Grid.Row="2" Grid.Column="6"
                             Style="{StaticResource DataText}"
                             Text="{Binding Inspector.Details.Signature, Mode=OneWay}" />

                  <TextBlock Grid.Row="4" Style="{StaticResource Eyebrow}" Text="Stored / decoded" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource DataText}">
                    <Run Text="{Binding Inspector.Details.StoredSize, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Inspector.Details.DecodedSize, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource Eyebrow}" Text="Key evidence" />
                  <TextBlock Grid.Row="4" Grid.Column="6"
                             Style="{StaticResource DataText}"
                             Text="{Binding Inspector.Details.KeyEvidence, Mode=OneWay}" />
                </Grid>
              </Expander>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Background="Transparent"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="2,12,2,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="Drop a client, PAKs, a Pack folder, pakkeys, or a .ttcapture anywhere." />
          <TextBlock Margin="0,3,0,0"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}">
            <Run Text="{Binding Operation.ArchiveName, Mode=OneWay}" />
            <Run Text=" · entry " />
            <Run Text="{Binding Operation.EntryOrdinal, Mode=OneWay}" />
            <Run Text="/" />
            <Run Text="{Binding Operation.EntryCount, Mode=OneWay}" />
            <Run Text=" · bytes " />
            <Run Text="{Binding Operation.CompletedDecodedBytes, Mode=OneWay}" />
            <Run Text="/" />
            <Run Text="{Binding Operation.TotalDecodedBytes, Mode=OneWay}" />
            <Run Text=" · failures " />
            <Run Text="{Binding Operation.FailureCount, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding Operation.Elapsed, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1"
                Style="{StaticResource QuietButton}"
                Command="{Binding CancelOperationCommand}"
                Content="Cancel operation" />
      </Grid>
