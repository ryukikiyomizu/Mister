<UserControl x:Class="Mister.App.Views.ArchiveInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mister.App.ViewModels"
             DataContext="{Binding DataContext.Inspector, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="96" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search the decoded path"
                 AutomationProperties.Name="Search decoded files" />
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Search files">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <Grid Grid.Column="2">
        <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Filter by extension, such as .png"
                 AutomationProperties.Name="Filter file extension" />
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text=".png">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ExtensionFilter}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 MaxWidth="240"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="Files appear here after the selected pack validates.">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding VisibleEntries.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ListBox x:Name="FileList"
               ItemsSource="{Binding VisibleEntries}"
               SelectedItem="{Binding SelectedEntry}"
               ScrollViewer.CanContentScroll="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.PanningMode="VerticalOnly"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel"
               AutomationProperties.Name="Files in selected logical pack">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ArchiveTreeNodeViewModel}">
            <Grid ToolTip="{Binding DecodedPath}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding FileName}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding DirectoryName}" />
                <TextBlock Margin="0,4,0,0"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="{Binding SourceArchiveName}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Margin="10,0,0,0"
                          HorizontalAlignment="Right">
                <Border HorizontalAlignment="Right"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="4"
                        Padding="6,2">
                  <TextBlock FontFamily="Cascadia Mono, Consolas"
                             FontSize="9"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="{Binding Extension}" />
                </Border>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding SizeLabel}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
