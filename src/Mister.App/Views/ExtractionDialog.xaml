<Window x:Class="Mister.App.Views.ExtractionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WorkbenchWindow}"
        Title="Extract and verify"
        Width="680"
        Height="760"
        MinWidth="600"
        MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
  <Border Margin="18"
          Style="{StaticResource SurfaceBorder}"
          Padding="26">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}"
                   Text="Verified output" />
        <TextBlock Style="{StaticResource DisplayTitle}"
                   Margin="0,4,0,0"
                   FontSize="28"
                   Text="Choose packs to extract" />
        <TextBlock Margin="0,7,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="Select one or more logical packs. Every base and numbered update layer belonging to each selection is preserved and verified." />
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontWeight="SemiBold"
                     Text="Logical packs" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="{Binding SelectedCountLabel}" />
        </StackPanel>
        <WrapPanel Grid.Column="1">
          <Button Margin="0,0,8,0"
                  Style="{StaticResource QuietButton}"
                  Click="OnSelectAll"
                  Content="Select all" />
          <Button Style="{StaticResource QuietButton}"
                  Click="OnClearAll"
                  Content="Clear all" />
        </WrapPanel>
      </Grid>

      <Border Grid.Row="4"
              Background="{StaticResource WindowBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="8">
        <ListBox x:Name="PackList"
                 ItemsSource="{Binding Packs}"
                 AutomationProperties.Name="Packs selected for extraction">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Padding="5"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding LayerSummary}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Margin="16,0,4,0"
                             VerticalAlignment="Center"
                             FontSize="12"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="{Binding FileCountLabel}" />
                </Grid>
              </CheckBox>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Row="6">
        <TextBlock Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   Text="Output folder" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding OutputDirectory, Mode=OneWay}"
                   IsReadOnly="True"
                   AutomationProperties.Name="Extraction output folder" />
          <Button Grid.Column="2"
                  Click="OnBrowseOutput"
                  Content="Choose folder" />
        </Grid>
      </StackPanel>

      <Border Grid.Row="8"
              Padding="14"
              Background="{StaticResource PrimarySubtleBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <CheckBox IsChecked="{Binding BuildMergedView}"
                  Content="Build one merged effective view (recommended)" />
      </Border>

      <Grid Grid.Row="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{Binding OutputHint}" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
          <Button Margin="0,0,8,0"
                  Style="{StaticResource QuietButton}"
                  Content="Cancel"
                  IsCancel="True" />
          <Button Style="{StaticResource PrimaryButton}"
                  Click="OnConfirm"
                  Content="Extract &amp; verify"
                  IsEnabled="{Binding CanConfirm}"
                  IsDefault="True" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
