<Window x:Class="Mister.App.Views.PakKeyRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WorkbenchWindow}"
        Title="Recover pakkey"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Style="{StaticResource SurfaceBorder}" Padding="20">
    <StackPanel>
      <TextBlock Style="{StaticResource Eyebrow}"
                 Foreground="{StaticResource WarningBrush}"
                 Text="T3 KEY RECOVERY" />
      <TextBlock Style="{StaticResource DisplayTitle}"
                 Margin="0,3,0,0"
                 FontSize="23"
                 Text="Review coverage" />
      <TextBlock Margin="0,7,0,0"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 TextWrapping="Wrap"
                 Text="Review recovered effective-key coverage before exporting a pakkey and its evidence report." />

      <Border Margin="0,18,0,0"
              Padding="14"
              Background="{StaticResource WarningSubtleBrush}"
              BorderBrush="{StaticResource WarningBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel>
          <TextBlock FontFamily="Cascadia Mono, Consolas"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource WarningBrush}">
            <Run Text="{Binding RecoveredCount, Mode=OneWay}" />
            <Run Text="/125" />
          </TextBlock>
          <TextBlock Margin="0,5,0,0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="{Binding CoverageLabel, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <TextBlock Margin="0,12,0,0"
                 FontSize="11"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="Partial coverage is never labeled complete." />

      <StackPanel Margin="0,20,0,0"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
        <Button Margin="0,0,8,0"
                Style="{StaticResource QuietButton}"
                Content="Close"
                IsCancel="True" />
        <Button Style="{StaticResource PrimaryButton}"
                Click="OnChooseExport"
                Content="Choose export folder"
                IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
